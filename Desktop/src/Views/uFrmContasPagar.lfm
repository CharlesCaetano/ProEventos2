      Font.Style = [fsBold]
      ParentFont = False
    end
    object lblTotalPago: TLabel
      Left = 300
      Height = 16
      Top = 10
      Width = 180
      Caption = 'Pago: R$ 0,00'
      Font.Color = clGreen
