    object btnAlertasFinanc: TBitBtn
      Left = 412
      Height = 28
      Top = 58
      Width = 140
      Caption = 'Alertas Financeiros'
      OnClick = btnAlertasFinancClick
    end
  end
  object pnlChat: TPanel
    Left = 0
    Height = 400
    Top = 150
    Width = 800
    Align = alClient
    TabOrder = 2
    object mmoChat: TMemo
      Left = 0
      Height = 400
      Top = 0
      Width = 800
      Align = alClient
      Font.Name = 'Consolas'
      Font.Height = -13
      ParentFont = False
      ReadOnly = True
      ScrollBars = ssVertical
      TabOrder = 0
    end
  end
  object pnlInput: TPanel
    Left = 0
    Height = 40
    Top = 550
    Width = 800
    Align = alBottom
    TabOrder = 3
    object edtPergunta: TEdit
      Left = 8
      Height = 28
      Top = 6
      Width = 620
      Font.Height = -14
      ParentFont = False
