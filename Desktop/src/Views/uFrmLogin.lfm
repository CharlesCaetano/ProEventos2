object frmLogin: TfrmLogin
  Left = 0
  Height = 350
  Top = 0
  Width = 420
  BorderStyle = bsDialog
  Caption = 'ERP 2026 - Login'
  ClientHeight = 350
  ClientWidth = 420
  Position = poScreenCenter
  OnCreate = FormCreate
  OnShow = FormShow
  LCLVersion = '3.0.0.0'
  object pnlTopo: TPanel
    Left = 0
    Height = 80
    Top = 0
    Width = 420
    Align = alTop
    Color = clNavy
    ParentColor = False
    TabOrder = 0
    object lblTitulo: TLabel
      Left = 16
      Height = 28
      Top = 12
      Width = 200
      Caption = 'ERP 2026'
      Font.Color = clWhite
      Font.Height = -24
      Font.Style = [fsBold]
      ParentFont = False
    end
    object lblSubtitulo: TLabel
      Left = 16
      Height = 16
      Top = 48
      Width = 250
      Caption = 'Sistema de Gestão Empresarial'
      Font.Color = clWhite
      Font.Height = -13
      ParentFont = False
    end
  end
  object pnlCentro: TPanel
    Left = 40
    Height = 220
    Top = 100
    Width = 340
    BevelOuter = bvNone
    TabOrder = 1
    object lblUsuario: TLabel
      Left = 0
      Height = 16
      Top = 0
      Width = 60
      Caption = 'Usuário:'
      Font.Height = -13
      Font.Style = [fsBold]
      ParentFont = False
    end
    object edtUsuario: TEdit
      Left = 0
      Height = 28
      Top = 20
      Width = 340
      Font.Height = -13
      ParentFont = False
      TabOrder = 0
    end
    object lblSenha: TLabel
      Left = 0
      Height = 16
      Top = 60
      Width = 50
      Caption = 'Senha:'
      Font.Height = -13
      Font.Style = [fsBold]
      ParentFont = False
    end
    object edtSenha: TEdit
      Left = 0
      Height = 28
      Top = 80
      Width = 340
      EchoMode = emPassword
      Font.Height = -13
      ParentFont = False
      PasswordChar = '*'
      TabOrder = 1
      OnKeyPress = edtSenhaKeyPress
    end
    object btnEntrar: TBitBtn
      Left = 0
      Height = 36
      Top = 130
      Width = 160
      Caption = 'Entrar'
      Font.Height = -13
      Font.Style = [fsBold]
      ParentFont = False
      TabOrder = 2
