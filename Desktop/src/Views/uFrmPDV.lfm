      ParentFont = False
    end
  end
  object pnlItens: TPanel
    Left = 0
    Height = 350
    Top = 90
    Width = 680
    Align = alClient
    TabOrder = 2
    object sgItens: TStringGrid
      Left = 0
      Height = 350
      Top = 0
      Width = 680
      Align = alClient
      ColCount = 6
      FixedCols = 0
      Font.Height = -14
      ParentFont = False
      Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goRowSelect]
      TabOrder = 0
    end
  end
  object pnlDireita: TPanel
