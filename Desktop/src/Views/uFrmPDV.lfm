      Left = 700
      Height = 16
      Top = 12
      Width = 180
      Caption = 'Caixa:'
      Font.Color = clYellow
      Font.Style = [fsBold]
      ParentFont = False
    end
  end
  object pnlBarras: TPanel
    Left = 0
    Height = 50
    Top = 40
    Width = 900
    Align = alTop
    Color = clWhite
