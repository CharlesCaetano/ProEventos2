      Left = 16
      Height = 20
      Top = 10
      Width = 200
      Caption = 'ERP 2026 - PDV'
      Font.Color = clWhite
      Font.Height = -16
      Font.Style = [fsBold]
      ParentFont = False
    end
    object lblOperador: TLabel
      Left = 350
      Height = 16
